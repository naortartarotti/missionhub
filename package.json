{
  "name": "missionhub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"next dev\" \"npm:worker\"",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --conditions=react-server scripts/worker.mts",
    "worker:once": "tsx --conditions=react-server scripts/worker.mts --once",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.mts",
    "db:start": "supabase start -x edge-runtime,logflare,vector,imgproxy,supavisor",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/server/db/database.types.ts",
    "db:seed:demo": "tsx --conditions=react-server scripts/seed-demo.mts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
