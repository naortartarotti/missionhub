# --- Supabase (required) ---
# Local: values printed by `supabase start` (ports configured in supabase/config.toml: API 55321).
# Hosted: Project Settings → API. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Used ONLY by the background worker and the internal matching service.
SUPABASE_SECRET_KEY=sb_secret_xxx

NEXT_PUBLIC_APP_URL=http://localhost:3000
# development | demo | production. Synthetic seed data may only be loaded when APP_ENV=demo or development.
APP_ENV=development

# --- Optional integrations (the app runs fully without them) ---
# AI provider for resume extraction / explanations. Unset => deterministic matching + manual entry.
AI_PROVIDER=
AI_API_KEY=
# Transactional email via Resend (Vercel Marketplace). Unset => no emails; invite links are shown to copy.
RESEND_API_KEY=
# Must be on a domain verified in Resend. Default onboarding@resend.dev only delivers to the account owner.
EMAIL_FROM=
