# --- Supabase (required) ---
# Local: values printed by `supabase start` (ports configured in supabase/config.toml: API 55321).
# Hosted: Project Settings → API. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Used ONLY by the background worker and the internal matching service.
SUPABASE_SECRET_KEY=sb_secret_xxx

NEXT_PUBLIC_APP_URL=http://localhost:3000
# development | demo | production. Synthetic seed data may only be loaded when APP_ENV=demo or development.
APP_ENV=development

# --- Optional integrations (the app runs fully without them) ---
# OpenAI: reads job postings (text / link / PDF, incl. scanned), resumes and powers semantic skill
# matching. Server-only. Unset => rule-based extraction + deterministic matching + manual entry.
OPENAI_API_KEY=
# Optional. Default gpt-5-mini. Any Chat Completions model with Structured Outputs + PDF input works.
OPENAI_MODEL=
# Optional, reasoning models only: minimal | low | medium | high. Lower = faster imports.
OPENAI_REASONING_EFFORT=
# Transactional email via Resend (Vercel Marketplace). Unset => no emails; invite links are shown to copy.
RESEND_API_KEY=
# Must be on a domain verified in Resend. Default onboarding@resend.dev only delivers to the account owner.
EMAIL_FROM=
# Supabase Auth emails through Resend (signup confirmation, password reset, email change…).
# Supabase Dashboard → Authentication → Hooks → "Send Email" → HTTPS, URL <app>/api/auth/send-email,
# then paste the generated secret here ("v1,whsec_…"). Unset => Supabase sends its own auth emails.
SEND_EMAIL_HOOK_SECRET=
# Wallet payments via Stripe (Checkout for commissions in, Connect for withdrawals out).
# Unset => the wallet stays read-only: no "pay through MissionHub", no payout setup, no withdrawals.
# The webhook endpoint is POST /api/stripe/webhook; see docs/payments.md for the events to subscribe to.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
