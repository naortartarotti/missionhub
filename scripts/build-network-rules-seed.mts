/**
 * Generates supabase/seed.sql: the LOCAL / demo Network Rules version 1.0 (N10, AC-35), built from
 * the current drafts in docs/content/network-rules/{en,fr-CA,pt-BR}.md with the PUBLISHING.md
 * procedure (markers stripped). Unapproved draft text: never publish it to a real environment
 * (seed.sql only runs on `supabase db reset`, never on `supabase db push`).
 *
 *   npx tsx scripts/build-network-rules-seed.mts
 */
import { readFileSync, writeFileSync } from "node:fs";
import path from "node:path";
import { RULES_LOCALES, findRulesMarkers, stripForPublish } from "../src/features/network-rules/domain";
import { rulesSha256 } from "../src/features/network-rules/hash";

const root = path.resolve(import.meta.dirname, "..");
// Mechanism table for the local seed: "Report a problem" (P0-3) ships with N10; the others haven't.
const SHIPPED = ["P0-3"];
const NOT_SHIPPED = ["N5", "access expiry (after N3)", "P1-5"];

const texts = Object.fromEntries(
  RULES_LOCALES.map((locale) => {
    const source = readFileSync(path.join(root, "docs/content/network-rules", `${locale}.md`), "utf8");
    const out = stripForPublish(source, {
      shipped: SHIPPED,
      notShipped: NOT_SHIPPED,
      locale,
      todoReplacement: (inner) => `(draft: ${inner})`,
    });
    const markers = findRulesMarkers(out);
    if (markers.length) throw new Error(`${locale}: markers left after stripping: ${JSON.stringify(markers)}`);
    return [locale, out];
  }),
) as Record<(typeof RULES_LOCALES)[number], string>;

const tag = "$rules$";
for (const t of Object.values(texts)) if (t.includes(tag)) throw new Error("dollar-quote tag collision");

const sql = `-- GENERATED by scripts/build-network-rules-seed.mts. Do not edit by hand.
-- Local / demo seed only (supabase db reset). N10 AC-35: a published Network Rules version built from
-- the unapproved drafts with markers stripped, so local logins and tests aren't blocked by the gate.
-- Fingerprints (SHA-256 of the stored text): ${RULES_LOCALES.map((l) => `${l} ${rulesSha256(texts[l])}`).join(" · ")}

do $seed$
declare
  v_id uuid;
begin
  if exists (select 1 from public.network_rules_versions) then return; end if;
  insert into public.network_rules_versions (label, type) values ('1.0', 'initial') returning id into v_id;
${RULES_LOCALES.map(
  (l) => `  insert into public.network_rules_version_texts (version_id, locale, body, sha256)
  values (v_id, '${l}', ${tag}${texts[l]}${tag}, repeat('0', 64));`,
).join("\n")}
  update public.network_rules_versions
     set status = 'published', published_at = now(), effective_at = now(),
         effective_on = (now() at time zone 'America/Toronto')::date,
         approval_reference = 'Local seed: unapproved drafts (P0-1 pending)',
         rule_numbers = (select coalesce(array_agg(x ->> 'number' order by o), '{}')
                           from public.network_rules_version_texts t, jsonb_array_elements(t.rules) with ordinality as e(x, o)
                          where t.version_id = v_id and t.locale = 'en')
   where id = v_id;
end $seed$;
`;

writeFileSync(path.join(root, "supabase/seed.sql"), sql);
console.log("supabase/seed.sql written");
